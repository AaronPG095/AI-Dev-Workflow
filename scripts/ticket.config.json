{
  "prefix": "ADW",
  "tracker": "local",
  "timeZone": "Europe/Berlin",
  "plansDir": "docs/plans",
  "protectedBranches": ["main"],
  "captureSources": ["Claude", "Codex", "Gemini", "ChatGPT", "Notion AI", "Other"],
  "verify": {
    "test": "node --test scripts/ticket.test.mjs",
    "full": "node --test scripts/ticket.test.mjs"
  },
  "verifyCommand": "node --test scripts/ticket.test.mjs",
  "hygiene": {
    "maxFileSizeKB": 1024,
    "disallowedPatterns": [".tmp", "test-results", "coverage", ".worktrees"]
  },
  "requireReview": true,
  "invariants": {
    "mirrorDirs": [[".agents/skills", ".claude/skills"]],
    "readmeCliSync": true,
    "zeroDependencies": true,
    "noSecretsPatterns": [
      "\\bntn_[A-Za-z0-9]{10,}",
      "\\bsecret_[A-Za-z0-9]{10,}",
      "\\bghp_[A-Za-z0-9]{20,}",
      "\\bgithub_pat_[A-Za-z0-9_]{20,}"
    ],
    "excludePaths": ["scripts/ticket.test.mjs", "scripts/ticket.config.json"]
  },
  "appetite": {
    "S": { "maxLines": 150, "maxFiles": 5 },
    "M": { "maxLines": 450, "maxFiles": 12 },
    "L": { "maxLines": 1000, "maxFiles": 25 }
  },
  "knownRepos": [
    "FluentOverlay",
    "Fluent-Studio-Website",
    "FluentTimer",
    "TokenHUD",
    "Fluent-Studio-Atlas",
    "AI-Cortex",
    "AI-Dev-Workflow"
  ],
  "agentic": {
    "maxRetries": 3,
    "verifyTier": "test"
  },
  "noPlan": {
    "maxChangedLines": 40,
    "noNewFilesUnder": ["scripts"]
  }
}
