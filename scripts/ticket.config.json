{
  "prefix": "ADW",
  "tracker": "local",
  "timeZone": "Europe/Berlin",
  "plansDir": "docs/plans",
  "protectedBranches": [
    "main"
  ],
  "captureSources": [
    "Claude",
    "Codex",
    "Gemini",
    "ChatGPT",
    "Notion AI",
    "Other"
  ],
  "verify": {
    "fast": "node --check scripts/ticket.mjs",
    "test": "node --test scripts/ticket.test.mjs",
    "full": "node --test scripts/ticket.test.mjs"
  },
  "verifyCommand": "node --test scripts/ticket.test.mjs",
  "hygiene": {
    "maxFileSizeKB": 1024,
    "disallowedPatterns": [
      ".tmp",
      "test-results",
      "coverage",
      ".worktrees"
    ]
  },
  "requireReview": true,
  "allowSelfReview": false,
  "invariants": {
    "mirrorDirs": [
      [
        ".agents/skills",
        ".claude/skills"
      ]
    ],
    "readmeCliSync": true,
    "zeroDependencies": true,
    "noSecretsPatterns": [
      "\\bntn_[A-Za-z0-9]{10,}",
      "\\bsecret_[A-Za-z0-9]{10,}",
      "\\bghp_[A-Za-z0-9]{20,}",
      "\\bgithub_pat_[A-Za-z0-9_]{20,}"
    ],
    "excludePaths": [
      "scripts/ticket.test.mjs",
      "scripts/ticket.config.json"
    ]
  },
  "appetite": {
    "S": {
      "maxLines": 150,
      "maxFiles": 5
    },
    "M": {
      "maxLines": 450,
      "maxFiles": 12
    },
    "L": {
      "maxLines": 1000,
      "maxFiles": 25
    }
  },
  "versioning": {
    "enabled": false,
    "currentVersion": "1.0.0",
    "activeTrain": "1.1.0",
    "roadmapPath": "docs/ROADMAP.md",
    "changelogPath": "CHANGELOG.md",
    "tagPrefix": "v",
    "requireVersionOnPlans": false
  },
  "knownRepos": [],
  "agentic": {
    "maxRetries": 3,
    "verifyTier": "test",
    "models": {
      "planner": "gemini-4-neon-medium",
      "builder": "gemini-4-hydrogen-medium",
      "fixer": "gemini-4-hydrogen-medium",
      "reviewer": "gemini-4-neon-low"
    },
    "modelProfiles": {
      "codex": {
        "models": {
          "planner": "gpt-6.2-sol",
          "builder": "gpt-6-luna",
          "fixer": "gpt-6-luna",
          "reviewer": "gpt-6.2-sol"
        },
        "reasoning": {
          "planner": "medium",
          "builder": "high",
          "fixer": "high",
          "reviewer": "medium"
        },
        "complexExecution": {
          "model": "gpt-6.2-sol",
          "reasoning": "medium"
        },
        "optIn": {
          "model": "gpt-6.2-astra",
          "reasoning": "low"
        },
        "offload": {
          "privacy": "local",
          "tasks": ["commit_msg", "log_trim", "classify"]
        }
      }
    }
  },
  "noPlan": {
    "maxChangedLines": 40,
    "noNewFilesUnder": [
      "scripts"
    ]
  }
}
