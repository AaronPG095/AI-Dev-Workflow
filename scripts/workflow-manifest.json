{
  "schemaVersion": 1,
  "copy": [
    "scripts/workflow-manifest.json",
    "scripts/ticket.mjs",
    "scripts/lib/markdown-plan.mjs",
    "scripts/lib/invariants-lint.mjs",
    "scripts/lib/stats-lessons.mjs",
    "scripts/lib/symbols-map.mjs",
    "scripts/ticket.test.mjs",
    "scripts/hooks/adw-hook.mjs",
    "scripts/sync.mjs",
    "scripts/sync-repos.ps1",
    "scripts/install.ps1",
    "scripts/install.sh",
    "docs/plans/_template.plan.md",
    ".agents/skills/quick-review/SKILL.md",
    ".claude/skills/quick-review/SKILL.md",
    ".agents/skills/agentic-workflow/SKILL.md",
    ".claude/skills/agentic-workflow/SKILL.md",
    ".agents/skills/agentic-workflow/references/level-a.md",
    ".agents/skills/agentic-workflow/references/level-b.md",
    ".agents/skills/agentic-workflow/references/level-c.md",
    ".claude/skills/agentic-workflow/references/level-a.md",
    ".claude/skills/agentic-workflow/references/level-b.md",
    ".claude/skills/agentic-workflow/references/level-c.md",
    ".github/pull_request_template.md"
  ],
  "prefix": [
    ".agents/skills/dev-workflow/SKILL.md",
    ".claude/skills/dev-workflow/SKILL.md"
  ],
  "branches": [
    ".github/workflows/plan-check.yml",
    ".github/workflows/ticket-done.yml"
  ],
  "starterConfig": {
    "tracker": "local",
    "timeZone": "Europe/Berlin",
    "plansDir": "docs/plans",
    "protectedBranches": ["main"],
    "captureSources": ["Claude", "Codex", "Gemini", "ChatGPT", "Notion AI", "Other"],
    "verify": {
      "test": "npm test",
      "full": "npm test"
    },
    "verifyCommand": "npm test",
    "hygiene": {
      "maxFileSizeKB": 1024,
      "disallowedPatterns": [".tmp", "test-results", "coverage", ".worktrees"]
    },
    "agentic": {
      "maxRetries": 3,
      "verifyTier": "test",
      "models": {
        "planner": "gemini-4-neon-medium",
        "builder": "gemini-4-hydrogen-medium",
        "fixer": "gemini-4-hydrogen-medium",
        "reviewer": "gemini-4-neon-low"
      },
      "modelProfiles": {
        "codex": {
          "models": {
            "planner": "gpt-6.2-sol",
            "builder": "gpt-6-luna",
            "fixer": "gpt-6-luna",
            "reviewer": "gpt-6.2-sol"
          },
          "reasoning": {
            "planner": "medium",
            "builder": "high",
            "fixer": "high",
            "reviewer": "medium"
          },
          "complexExecution": {
            "model": "gpt-6.2-sol",
            "reasoning": "medium"
          },
          "optIn": {
            "model": "gpt-6.2-astra",
            "reasoning": "low"
          },
          "offload": {
            "privacy": "local",
            "tasks": ["commit_msg", "log_trim", "classify"]
          }
        }
      }
    },
    "requireReview": true,
    "allowSelfReview": false,
    "invariants": {
      "mirrorDirs": [[".agents/skills", ".claude/skills"]],
      "noSecretsPatterns": [
        "\\bntn_[A-Za-z0-9]{10,}",
        "\\bsecret_[A-Za-z0-9]{10,}",
        "\\bghp_[A-Za-z0-9]{20,}",
        "\\bgithub_pat_[A-Za-z0-9_]{20,}"
      ],
      "excludePaths": ["scripts/ticket.test.mjs", "scripts/ticket.config.json"]
    },
    "appetite": {
      "S": { "maxLines": 150, "maxFiles": 5 },
      "M": { "maxLines": 450, "maxFiles": 12 },
      "L": { "maxLines": 1000, "maxFiles": 25 }
    },
    "versioning": {
      "enabled": false,
      "currentVersion": "1.0.0",
      "activeTrain": "1.1.0",
      "roadmapPath": "docs/ROADMAP.md",
      "changelogPath": "CHANGELOG.md",
      "tagPrefix": "v",
      "requireVersionOnPlans": false
    },
    "noPlan": {
      "maxChangedLines": 40,
      "noNewFilesUnder": ["src"]
    }
  }
}
