{
  "prefix": "PROJ",
  "tracker": "notion",
  "dataSourceId": "<notion-tasks-data-source-uuid>",
  "projectPageId": "<notion-project-page-uuid>",
  "tag": "Work / Project",
  "lifeAreaPageId": "<notion-life-area-page-uuid-optional>",
  "timeZone": "Europe/Berlin",
  "plansDir": "docs/plans",
  "protectedBranches": ["main", "develop"],
  "captureSources": ["Claude", "Codex", "Gemini", "ChatGPT", "Notion AI", "Other"],
  "verify": {
    "fast": "npm run lint",
    "test": "npm test",
    "full": "npm run build && npm test"
  },
  "verifyCommand": "npm test",
  "prePushVerify": false,
  "ciSkipTicketTests": false,
  "ci": {
    "ticketDoneWorkflow": true
  },
  "hygiene": {
    "maxFileSizeKB": 1024,
    "disallowedPatterns": [".tmp", "test-results", "coverage", ".worktrees"]
  },
  "requireReview": true,
  "allowSelfReview": false,
  "knownRepos": [
    "my-backend",
    "my-frontend",
    "my-shared-lib"
  ],
  "packMaxFileLines": 120,
  "packMaxLines": 400,
  "packIgnore": [],
  "agentic": {
    "maxRetries": 3,
    "verifyTier": "test",
    "models": {
      "planner": "gemini-4-neon-medium",
      "builder": "gemini-4-hydrogen-medium",
      "fixer": "gemini-4-hydrogen-medium",
      "reviewer": "gemini-4-neon-low"
    },
    "modelProfiles": {
      "codex": {
        "models": {
          "planner": "gpt-6.2-sol",
          "builder": "gpt-6-luna",
          "fixer": "gpt-6-luna",
          "reviewer": "gpt-6.2-sol"
        },
        "reasoning": {
          "planner": "medium",
          "builder": "high",
          "fixer": "high",
          "reviewer": "medium"
        },
        "complexExecution": {
          "model": "gpt-6.2-sol",
          "reasoning": "medium"
        },
        "optIn": {
          "model": "gpt-6.2-astra",
          "reasoning": "low"
        },
        "offload": {
          "privacy": "local",
          "tasks": ["commit_msg", "log_trim", "classify"]
        }
      }
    }
  },
  "versioning": {
    "enabled": false,
    "currentVersion": "1.0.0",
    "activeTrain": "1.1.0",
    "roadmapPath": "docs/ROADMAP.md",
    "changelogPath": "CHANGELOG.md",
    "tagPrefix": "v",
    "requireVersionOnPlans": false
  },
  "noPlan": {
    "maxChangedLines": 40,
    "noNewFilesUnder": ["src"]
  }
}
