{
  "prefix": "PROJ",
  "tracker": "notion",
  "dataSourceId": "<notion-tasks-data-source-uuid>",
  "projectPageId": "<notion-project-page-uuid>",
  "tag": "Work / Project",
  "lifeAreaPageId": "<notion-life-area-page-uuid-optional>",
  "timeZone": "Europe/Berlin",
  "plansDir": "docs/plans",
  "protectedBranches": ["main", "develop"],
  "captureSources": ["Claude", "Codex", "Gemini", "ChatGPT", "Notion AI", "Other"],
  "verify": {
    "fast": "npm run lint",
    "test": "npm test",
    "full": "npm run build && npm test"
  },
  "verifyCommand": "npm test",
  "hygiene": {
    "maxFileSizeKB": 1024,
    "disallowedPatterns": [".tmp", "test-results", "coverage", ".worktrees"]
  },
  "requireReview": false,
  "knownRepos": [
    "my-backend",
    "my-frontend",
    "my-shared-lib"
  ],
  "packMaxFileLines": 120,
  "packMaxLines": 400,
  "packIgnore": [],
  "agentic": {
    "maxRetries": 3,
    "verifyTier": "test"
  },
  "versioning": {
    "enabled": false,
    "currentVersion": "1.0.0",
    "activeTrain": "1.1.0",
    "roadmapPath": "docs/ROADMAP.md",
    "changelogPath": "CHANGELOG.md",
    "tagPrefix": "v",
    "requireVersionOnPlans": false
  },
  "noPlan": {
    "maxChangedLines": 40,
    "noNewFilesUnder": ["src"]
  }
}
